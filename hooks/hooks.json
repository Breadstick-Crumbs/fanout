{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "name": "fanout guard: block edits outside this session's files",
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/fanout/fanout.mjs\" guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "name": "fanout: tell this session when another commits changes to files it has read or edited",
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/fanout/fanout.mjs\" notice"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "fanout: start the same-work check while the session reads, so its first edit doesn't wait",
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/fanout/fanout.mjs\" prompt"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "fanout: tell a new session what the other sessions in this repo are doing",
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/fanout/fanout.mjs\" session-start"
          }
        ]
      }
    ]
  }
}
